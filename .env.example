# PrepSense — environment template.
#
# Copy to `.env.local` and fill in. Never put real values in this file; it is committed.
#
#   cp .env.example .env.local
#
# Every variable below is one the code actually reads, checked against
# `grep -r "process.env." app lib scripts`, so this file and the code cannot drift
# apart silently.

# ─── Supabase (required) ──────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses row-level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI provider (required) ───────────────────────────────────────────────
# Groq is the only provider. The free tier (2,000 requests/day) covers
# development and demos, and this same key also serves Whisper transcription —
# one key for both question generation and speech-to-text.
#
# Gemini, Claude, OpenAI and LM Studio support was removed deliberately: the old
# router fell back to Gemini whenever the provider variable was unset or
# misspelled, so a misconfigured environment quietly answered with a different
# model than intended. There is no ACTIVE_AI_PROVIDER variable any more.
#
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ─── RL policy service (optional) ─────────────────────────────────────────
# The trained curriculum controller (Model 1), served by `ml/serve.py`:
#
#   cd ml && .venv/bin/uvicorn serve:app --port 8000
#
# Genuinely optional. With the service down the app falls back to a Thompson bandit and
# then to the LLM's own question plan, so interviews still work — that fallback chain is
# what `scripts/test-chooser.ts` tests.
POLICY_URL=http://localhost:8000
POLICY_ENABLED=true
# Short on purpose: the chooser must not hold up a question when the service is slow.
POLICY_TIMEOUT_MS=1500

# ─── Development switches ─────────────────────────────────────────────────
# Skips auth and lets you view pages without logging in. Leave false for anything
# resembling a real run: it also makes the service-role client genuinely bypass RLS,
# which hides permission bugs until they appear in production.
NEXT_PUBLIC_DEV_BYPASS=false
# Returns canned AI responses instead of calling a provider. Useful with no API key, but
# every topic then moves identically, which makes knowledge tracing unverifiable.
MOCK_AI=false
